<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ╔══════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║ VARIANT : Jellyfin 10.10.x                                           ║ -->
    <!-- ║                                                                      ║ -->
    <!-- ║ Compile uniquement Compat/Jellyfin10_10/ (Jellyfin10_11 exclu via    ║ -->
    <!-- ║ <Compile Remove>). Les APIs utilisées (Users propriété,              ║ -->
    <!-- ║ Policy.IsAdministrator) sont stables sur 10.10.x.                    ║ -->
    <!-- ║                                                                      ║ -->
    <!-- ║ TargetFramework = net8.0 (10.10 a précédé la migration vers .NET 9). ║ -->
    <!-- ╚══════════════════════════════════════════════════════════════════════╝ -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.InfoPopup</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.InfoPopup</RootNamespace>
    <!-- Cf. jf10.11.csproj pour la raison du non-override des output paths. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <Version>4.2.0.0</Version>
  </PropertyGroup>

  <!-- Exclut l'implémentation Compat de la variant SŒUR (jf10.11) :
       elle utilise des APIs (GetUsers, HasPermission, PermissionKind) qui
       n'existent pas encore dans Jellyfin.Controller 10.10.*. -->
  <ItemGroup>
    <Compile Remove="Compat/Jellyfin10_11/**" />
    <None Include="Compat/Jellyfin10_11/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.10.*">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.10.*">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Donne accès à IStartupFilter, IApplicationBuilder, HttpContext, etc. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Icône du plugin (visible dans le tableau de bord Jellyfin) -->
  <ItemGroup>
    <EmbeddedResource Include="..\assets\icon.png">
      <LogicalName>Jellyfin.Plugin.InfoPopup.thumb.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Ressources web embarquées dans l'assembly -->
  <ItemGroup>
    <EmbeddedResource Include="Web\configurationpage.html" />
    <EmbeddedResource Include="Web\client.js" />
    <EmbeddedResource Include="Web\ip-i18n.js" />
    <EmbeddedResource Include="Web\ip-utils.js" />
    <EmbeddedResource Include="Web\ip-styles.js" />
    <EmbeddedResource Include="Web\ip-admin-editor.js" />
    <EmbeddedResource Include="Web\ip-admin-targets.js" />
    <EmbeddedResource Include="Web\ip-admin-permissions.js" />
    <EmbeddedResource Include="Web\ip-admin-settings.js" />
    <EmbeddedResource Include="Web\ip-admin-messages.js" />
    <EmbeddedResource Include="Web\ip-admin.js" />
    <EmbeddedResource Include="Web\ip-popup.js" />
    <EmbeddedResource Include="Web\ip-user.js" />
    <EmbeddedResource Include="Web\usermessagespage.html" />
  </ItemGroup>

</Project>
