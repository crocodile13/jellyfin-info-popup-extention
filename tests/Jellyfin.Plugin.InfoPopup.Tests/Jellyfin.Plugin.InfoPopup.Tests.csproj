<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ╔══════════════════════════════════════════════════════════════════════╗ -->
    <!-- ║ TESTS PROJECT (v4.1.1.0)                                             ║ -->
    <!-- ║                                                                      ║ -->
    <!-- ║ Tests xUnit pour les helpers critiques du plugin.                    ║ -->
    <!-- ║ Indépendant des variants jf10.10 / jf10.11 — référence la variant    ║ -->
    <!-- ║ moderne (jf10.11) pour la compile, mais les tests ciblent UNIQUEMENT ║ -->
    <!-- ║ les méthodes statiques pures (NormalizeUserId, IsValidId, IsOwner    ║ -->
    <!-- ║ via la base controller) qui ne dépendent d'aucune API Jellyfin       ║ -->
    <!-- ║ runtime.                                                             ║ -->
    <!-- ║                                                                      ║ -->
    <!-- ║ Build via `make test` (Makefile cible v4.1.1.0). Pas inclus dans     ║ -->
    <!-- ║ les ZIPs des variants (l'assembly Tests n'est pas dans le projet     ║ -->
    <!-- ║ jf10.X.csproj).                                                      ║ -->
    <!-- ╚══════════════════════════════════════════════════════════════════════╝ -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Désactive l'analyseur strict pour éviter les warnings « test trop simple » -->
    <NoWarn>CA1707;CA2007;CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Référence la variant jf10.11 (moderne, net9.0) pour récupérer les classes
       à tester. Les tests appellent uniquement des méthodes statiques pures,
       donc le runtime Jellyfin n'est PAS chargé pendant l'exécution. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Jellyfin.Plugin.InfoPopup\Jellyfin.Plugin.InfoPopup.jf10.11.csproj" />
  </ItemGroup>

</Project>
